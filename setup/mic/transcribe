#!/bin/bash
# Turn a recording of the microphone array into text.
#
# Split out of `dictate` because the panel button records for as long as you
# hold the conversation open -- start on one tap, stop on the next -- and so it
# owns the recording itself. This is the half they share.
#
# Why the settings are what they are: see the comments in `dictate`, and the
# README's "Speaking to it".
set -u
HERE=$(cd -- "$(dirname -- "$0")" && pwd)
W=${WHISPER_DIR:-$HOME/whisper.cpp}
MODEL=${WHISPER_MODEL:-$W/models/ggml-base.bin}
RAW=${1:?usage: transcribe <wav> [lang]}
LANG_CODE=${2:-${WHISPER_LANG:-auto}}

# The prompt is language-specific, and for Chinese it is doing two jobs at once:
# choosing the script, and carrying the words that otherwise come out wrong. For
# the others it has nothing to fix -- English and Japanese have no Simplified
# problem -- and a Chinese prompt in front of Japanese audio is actively
# misleading, which is the bug this avoids by keying on the language rather than
# shipping one prompt for everything.
# `auto` keeps the Chinese prompt rather than dropping it. Not knowing the
# language is not the same as knowing it is not Chinese, this device's is, and
# the prompt was measured to be harmless the other way: English audio with the
# Chinese prompt and -l auto still transcribed as English. Dropping it here
# would have quietly returned the command line to Simplified output.
case "$LANG_CODE" in
	zh|auto) DEFAULT_PROMPT="以下是繁體中文的句子。語音輸入、刪除資料、錯字、正確、平板、電子紙、終端機。" ;;
	*)       DEFAULT_PROMPT="" ;;
esac
PROMPT=${WHISPER_PROMPT:-$DEFAULT_PROMPT}
MONO=${RAW%.wav}-mono.wav

[ -x "$W/build/bin/whisper-cli" ] || {
	echo "no whisper-cli under $W -- see the README's speech section" >&2
	exit 1
}
[ -s "$MODEL" ] || { echo "no model at $MODEL" >&2; exit 1; }
[ -s "$RAW" ] || { echo "no recording at $RAW" >&2; exit 1; }

python3 "$HERE/beam.py" "$RAW" "$MONO" --gate "${DICTATE_GATE:-1.6}" >/dev/null
case $? in
	0) ;;
	3) exit 0 ;;   # nothing said; say nothing back
	*) exit 1 ;;
esac

"$W/build/bin/whisper-cli" -m "$MODEL" -f "$MONO" -l "$LANG_CODE" -t 4 -np \
	--prompt "$PROMPT" 2>/dev/null |
	sed -E 's/^\[[0-9:.]+ --> [0-9:.]+\][[:space:]]*//' |
	sed '/^[[:space:]]*$/d'

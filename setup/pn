#!/usr/bin/env bash
# pn — one place to see the state of every feature we added on this device, one
# place to switch them.
#
# 🔴 It **owns no state**. Each feature's source of truth stays in its own home
#    — gsettings, a systemd unit, ~/.config/*.json, sysfs — this script is only
#    a unified read/write entry point. So after a reflash it recognizes whatever
#    setup.sh built the moment it runs, with no database of its own; and that's
#    also why it reports **current state**, not configured values: Wi-Fi
#    power-save asks iw, the input method asks ibus, the waveform asks sysfs.
#    What a config file says and what's actually true are two different things,
#    and this device has already been bitten by that gap.
#
# Usage
#   pn                      state of every feature
#   pn <name>               state of one feature
#   pn <name> on|off        toggle (only the ones marked ⇄ support this)
#   pn ime add|rm <engine>  add/remove from the input method cycle (order = tap order)
#   pn panel hide|show <key>  top-row buttons
set -u

# ── helpers ──────────────────────────────────────────────────────────────
ok()   { printf '  \033[1m%-14s\033[0m %s\n' "$1" "$2"; }
warn() { printf '  \033[1m%-14s\033[0m \033[33m%s\033[0m\n' "$1" "$2"; }
die()  { echo "pn: $*" >&2; exit 1; }
gs()   { gsettings get "$1" "$2" 2>/dev/null; }
unit_active() { systemctl --user is-active "$1" 2>/dev/null; }
ext_state() {
  gnome-extensions info "$1" 2>/dev/null | awk -F': ' '/State:/{print $2}'
}
# The panel's D-Bus interface. This runs over SSH, so what's on the glass has to be asked for.
panel_info() {
  gdbus call --session --dest org.cver.PnPanel --object-path /org/cver/PnPanel \
    --method org.cver.PnPanel.PanelInfo 2>/dev/null | python3 -c '
import sys,json,ast
raw=sys.stdin.read().strip()
if not raw: sys.exit(0)
d=json.loads(ast.literal_eval(raw)[0])
print(json.dumps(d))'
}

# ── one status / on / off pair per feature ────────────────────────────────
# The name is the same one setup.sh / the README use. Adding a feature = adding
# a f_<name>_status (required) and a f_<name>_set on|off (optional; no set = read-only).

# Typing mode: A2 waveform + clear trigger. Source of truth is in sysfs.
f_typing_status() {
  local P=/sys/module/rockchip_ebc/parameters
  local wf; wf=$(cat $P/default_waveform 2>/dev/null)
  local pp; pp=$(cat $P/prepare_prev_before_a2 2>/dev/null)
  local st; st=$(unit_active pn-typing-mode.service)
  ok typing "unit=$st waveform=${wf:-?} prepare_prev=${pp:-?}"
}
f_typing_set() {
  case $1 in
    on)  systemctl --user enable --now pn-typing-mode.service ;;
    off) systemctl --user disable --now pn-typing-mode.service ;;
  esac
}

# Idle clear.
f_idle_status() { ok idle-refresh "$(unit_active pn-idle-refresh.service)"; }
f_idle_set() {
  case $1 in
    on)  systemctl --user enable --now pn-idle-refresh.service ;;
    off) systemctl --user disable --now pn-idle-refresh.service ;;
  esac
}

# The three extensions.
f_osk_status()   { ok osk   "$(ext_state pn-osk@cver.net)"; }
f_panel_status() { ok panel "$(ext_state pn-panel@cver.net)"; }
f_wave_status()  { ok wave  "$(ext_state pn-wave@cver.net)"; }
f_osk_set()   { gnome-extensions "$([ "$1" = on ] && echo enable || echo disable)" pn-osk@cver.net; }
f_panel_set() { gnome-extensions "$([ "$1" = on ] && echo enable || echo disable)" pn-panel@cver.net; }
f_wave_set()  { gnome-extensions "$([ "$1" = on ] && echo enable || echo disable)" pn-wave@cver.net; }

# k6 layout (k6Layout in pn-osk.json).
f_k6_status() {
  local v; v=$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.config/pn-osk.json"))).get("k6Layout",True))' 2>/dev/null)
  ok k6 "${v:-?}"
}
f_k6_set() {
  python3 - "$1" <<'PY'
import json,os,sys
p=os.path.expanduser("~/.config/pn-osk.json")
d=json.load(open(p))
d["k6Layout"]= sys.argv[1]=="on"
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False)
PY
  echo "  (pn-osk re-reads this on its next rebuild — dismiss and bring up the keyboard again to trigger one)"
}

# Wi-Fi power-save. Source of truth is iw, not the config file.
f_wifi_status() {
  local ps; ps=$(/usr/sbin/iw dev wlan0 get power_save 2>/dev/null | awk '{print $3}')
  if [ "$ps" = "off" ]; then ok wifi-powersave "off (good)"; else warn wifi-powersave "${ps:-unknown} — this device will drop off the network, see lifeline.sh [5]"; fi
}
f_wifi_set() {
  case $1 in
    on)  sudo /usr/sbin/iw dev wlan0 set power_save on ;;
    off) sudo /usr/sbin/iw dev wlan0 set power_save off ;;
  esac
}

# Input method. Source of truth: gsettings' list + the ibus engine currently in use.
f_ime_status() {
  local cur; cur=$(ibus engine 2>/dev/null)
  local list; list=$(gs org.gnome.desktop.input-sources sources)
  local face; face=$(panel_info | python3 -c '
import sys,json
raw=sys.stdin.read().strip()
if raw:
    d=json.loads(raw)
    print([i["content"][0] for i in d.get("right",[]) if i["role"]=="pn-input"][0])' 2>/dev/null)
  ok ime "current=${cur:-?} face=${face:-?}"
  ok "" "cycle=$list"
}
# pn ime add|rm <engine>: edit the list. Order = the order pn-input taps through.
# pn ime face <US|JP|TW|pinyin|bopomofo>: jump straight to that face. TW = pinyin
# (the first one); pinyin / bopomofo are two schemas of the same rime engine, both
# shown as TW on the top row — the difference is in the keycaps.
f_ime_cmd() {
  local op=$1 eng=${2:-}
  if [ "$op" = face ]; then
    [ -n "$eng" ] || die "pn ime face <US|JP|TW|pinyin|bopomofo>"
    gdbus call --session --dest org.cver.PnPanel --object-path /org/cver/PnPanel \
      --method org.cver.PnPanel.InputFace "$eng" >/dev/null && f_ime_status
    return
  fi
  [ -n "$eng" ] || die "pn ime $op <engine>  (rime / mozc-on / chewing / hangul)"
  python3 - "$op" "$eng" <<'PY'
import subprocess,sys,ast
op,eng=sys.argv[1],sys.argv[2]
raw=subprocess.check_output(["gsettings","get","org.gnome.desktop.input-sources","sources"],text=True)
lst=ast.literal_eval(raw.strip())
item=("ibus",eng)
if op=="add" and item not in lst: lst.append(item)
if op=="rm"  and item in lst:     lst.remove(item)
if not lst or lst[0]!=("xkb","us"): lst=[("xkb","us")]+[x for x in lst if x!=("xkb","us")]
val="["+", ".join(f"('{a}','{b}')" for a,b in lst)+"]"
subprocess.check_call(["gsettings","set","org.gnome.desktop.input-sources","sources",val])
print("  sources =",val)
PY
}

# Top-row buttons. Source of truth is the panel itself.
f_buttons_status() {
  panel_info | python3 -c '
import sys,json
raw=sys.stdin.read().strip()
if not raw: print("  buttons        (pn-panel not reachable)"); sys.exit(0)
d=json.loads(raw)
rows=[i for i in d.get("right",[]) if i["role"].startswith("pn-")]
parts=[]
for r in rows:
    parts.append(r["role"][3:] + "=" + ("on" if r["visible"] else "off"))
print("  buttons       ", " ".join(parts))'

}

# pn buttons <input|tone|refresh|rotate> on|off: writes ~/.config/pn-panel.json,
# then disables/enables the extension to make it re-read. A disabled button is
# simply not created (see readPanelConfig in pn-panel), so a reload is needed
# for it to disappear — not instant, but no restart gdm3 needed either.
f_buttons_cmd() {
  local key=$1 val=${2:-}
  case $key in input|tone|refresh|rotate) ;; *) die "pn buttons <input|tone|refresh|rotate> on|off" ;; esac
  case $val in on|off) ;; *) die "pn buttons $key on|off" ;; esac
  python3 - "$key" "$val" <<'PY'
import json,os,sys
p=os.path.expanduser("~/.config/pn-panel.json")
d={}
if os.path.exists(p):
    try: d=json.load(open(p))
    except Exception: d={}
d.setdefault("buttons",{})[sys.argv[1]]= sys.argv[2]=="on"
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False); open(p,"a").write("\n")
print("  pn-panel.json buttons =",d["buttons"])
PY
  gnome-extensions disable pn-panel@cver.net && sleep 1 && gnome-extensions enable pn-panel@cver.net
  sleep 2
  f_buttons_status
}

# pn reload: restart gdm3. Needed after changing any extension's extension.js —
# GNOME caches modules, disable/enable only re-reads the stylesheet and json,
# never the JS. autologin is on, so the session comes back by itself (see the
# README's "Reloading an extension" section).
# 🔴 Running this over SSH will drop your connection once. That's expected.
#
# 🔴 It stalls at the greeter, and not occasionally — this device's session
#    teardown takes more than five seconds, and gdm's grace period for the old
#    PAM worker is exactly five seconds. It wins a dozen times in a row, then
#    loses two in a row — the only difference is whether the SoC happens to be
#    busy at that moment. The log looks like this:
#      15:49:47  Stopping gnome-terminal-server / gvfs-* / xdg-*-portal ...
#      15:49:52  gdm-session-worker [pam/gdm-autologin] isn't dying after 5 seconds
#      15:49:52  pam_unix(gdm-autologin:session): session opened      ← the new one
#      15:49:53  pam_unix(gdm-autologin:session): session closed      ← only now does the old one die
#      15:49:53  GdmDisplay: Session never registered, failing        ← the new one gets swept away with it
#    Betting on the edge is pointless. So tear the session down cleanly first
#    (terminate-session, then wait for it to actually vanish from loginctl) —
#    by the time gdm comes up there's nothing left to wait on. It's not a
#    second restart papering over the failure, it's removing the first
#    restart's reason to fail.
#
#    This script itself is running inside a session (SSH counts as a user
#    session too, just not the seat0 one) — the one being terminated is the
#    seat0 graphical session, so this SSH connection survives.
f_reload_cmd() {
  # 🔴 Hand the whole thing off to systemd instead of doing it in this shell.
  #    terminate-session takes down the same user's SSH scope along with it —
  #    run over SSH, this script would be the first thing to die, so the
  #    second half (restart gdm3) never runs, and any file mid-scp gets left
  #    half-written (happened for real on 2026-08-18: extension.js truncated
  #    at line 808, U+0000).
  #    systemd-run's unit lives at the system level, outside any user session,
  #    so it survives.
  echo "  handing off to systemd: terminate seat0 session → wait → restart gdm3"
  echo "  (this SSH connection will drop; the desktop is back in ~10s)"
  sudo systemd-run --unit=pn-reload --collect bash -c '
    sid=$(loginctl list-sessions --no-legend | awk "\$2==1000 && \$4==\"seat0\"{print \$1}" | head -1)
    if [ -n "$sid" ]; then
      loginctl terminate-session "$sid"
      for _ in $(seq 1 30); do
        loginctl list-sessions --no-legend | awk "{print \$1}" | grep -qx "$sid" || break
        sleep 1
      done
    fi
    systemctl restart gdm3
    sleep 25
    loginctl list-sessions --no-legend | grep -qE " 1000 +user +seat0" || systemctl restart gdm3
  ' >/dev/null 2>&1
}

# ── dispatch ───────────────────────────────────────────────────────────────
ALL="typing idle osk panel wave k6 wifi ime buttons"

if [ $# -eq 0 ]; then
  echo "pn — current state (reads the source of truth, not the config file)"
  for f in $ALL; do "f_${f}_status"; done
  echo
  echo "toggleable (pn <name> on|off): typing idle osk panel wave k6 wifi"
  echo "input method: pn ime add|rm <engine>    top row: pn buttons <input|tone|refresh|rotate> on|off"
  echo "after changing an extension's JS: pn reload (restart gdm3)"
  exit 0
fi

name=$1; shift
case $name in
  ime)
    if [ $# -eq 0 ]; then f_ime_status; else f_ime_cmd "$@"; fi ;;
  buttons)
    if [ $# -eq 0 ]; then f_buttons_status; else f_buttons_cmd "$@"; fi ;;
  reload)
    f_reload_cmd ;;
  *)
    declare -F "f_${name}_status" >/dev/null || die "unknown: $name  (one of: $ALL)"
    if [ $# -eq 0 ]; then "f_${name}_status"
    else
      declare -F "f_${name}_set" >/dev/null || die "$name is read-only"
      case $1 in on|off) ;; *) die "pn $name on|off" ;; esac
      "f_${name}_set" "$1" && "f_${name}_status"
    fi ;;
esac
